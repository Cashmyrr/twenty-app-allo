{
  "name": "@cashmyrr/twenty-app-allo",
  "version": "0.3.0",
  "description": "Allo for Twenty: sync Allo calls into Twenty as records linked to the member and the person, and send any selection to the Allo Power Dialer",
  "license": "MIT",
  "author": "Cashmyrr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cashmyrr/twenty-app-allo.git"
  },
  "bugs": {
    "url": "https://github.com/Cashmyrr/twenty-app-allo/issues"
  },
  "homepage": "https://github.com/Cashmyrr/twenty-app-allo#readme",
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2",
    "twenty": ">=2.42.0"
  },
  "keywords": [
    "twenty-app",
    "twenty",
    "allo",
    "telephony",
    "crm",
    "power-dialer"
  ],
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint --fix -c .oxlintrc.json .",
    "typecheck": "tsgo --noEmit -p tsconfig.spec.json",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "backfill": "node scripts/backfill-allo-calls.mts",
    "backfill:last-call": "node scripts/backfill-last-allo-call.mts"
  },
  "dependencies": {
    "libphonenumber-js": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "oxlint": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twenty-client-sdk": "2.51.1",
    "twenty-sdk": "2.51.1",
    "twenty-ui": "2.51.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.0.0"
  }
}
