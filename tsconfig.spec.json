{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
